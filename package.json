{
  "name": "banquier",
  "version": "1.30.0",
  "description": "Application de gestion de relevés bancaires",
  "main": "./out/main/index.js",
  "author": "jessux <jessux@users.noreply.github.com>",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "set \"ELECTRON_GET_USE_PROXY=true\" && set \"NODE_TLS_REJECT_UNAUTHORIZED=0\" && npm run build && electron-builder --win",
    "build:win:dir": "set \"ELECTRON_GET_USE_PROXY=true\" && set \"NODE_TLS_REJECT_UNAUTHORIZED=0\" && npm run build && electron-builder --win --dir",
    "typecheck:mobile": "tsc -p tsconfig.mobile.json",
    "build:android": "electron-vite build && npx cap sync android",
    "build:ios": "electron-vite build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capawesome/capacitor-file-picker": "^8.0.3",
    "@langchain/core": "^1.2.1",
    "@langchain/openai": "^1.5.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^7.0.5",
    "nat-upnp": "^0.2.1",
    "node-fetch": "^2.7.0",
    "node-sqlite3-wasm": "^0.8.18",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react-is": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.5.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/nat-upnp": "^1.1.5",
    "@types/node": "^20.14.8",
    "@types/node-fetch": "^2.6.11",
    "@types/papaparse": "^5.3.14",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "patch-package": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.2"
  },
  "build": {
    "appId": "com.banquier.app",
    "productName": "Banquier",
    "directories": {
      "buildResources": "resources"
    },
    "publish": {
      "provider": "github",
      "owner": "jessux",
      "repo": "Banquier",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance"
    }
  }
}
